# 이름만 있는 예시. 실제 값은 .env.local에 넣고 커밋하지 않는다.

# --- 브라우저에 노출되어도 되는 값만 (VITE_ 접두사) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- 브라우저에 넣지 않는 값 (VITE_ 접두사 금지) ---
# 강사 방 만들기용 파일럿 코드 원문. 테스트(npm test)와 운영자 메모용. DB에는 bcrypt 해시만 저장.
PILOT_CODE=
# service_role key는 이 프로젝트에서 쓰지 않는다. 절대 커밋·프런트에 넣지 않는다.
